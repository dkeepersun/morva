/* A reviewable order confirmation model.
   Comments never change the modeled transition. */
system Shop {
  enum OrderStatus {
    Pending
    Confirmed
    Cancelled
  }

  module Orders {
    entity Order {
      id: Id
      status: OrderStatus
    }

    action Confirm(order: Order) {
      idempotent by order.id
      requires order.status == Pending
      effects order.status = Confirmed
      ensures order.status == Confirmed

      implementation_hint {
        storage: relational
        consistency: strong
      }
    }

    scenario NormalConfirmation {
      given order.status = Pending
      run Confirm(order)
      expect order.status == Confirmed
    }
  }
}
