{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morva Checked Semantics Protocol v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocol", "version", "capabilities", "producer", "subject", "sources", "result"],
  "properties": {
    "protocol": { "const": "morva.checked-semantics" },
    "version": { "const": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "allOf": [
        { "contains": { "const": "morva.sources.inline" } },
        { "contains": { "const": "morva.locations.byte-range" } },
        { "contains": { "const": "morva.findings.v1" } },
        { "contains": { "const": "morva.coverage.v1" } },
        { "contains": { "const": "morva.checked-model.v1" } }
      ]
    },
    "producer": { "$ref": "#/$defs/producer" },
    "subject": { "$ref": "#/$defs/subject" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "morva" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "name", "revision"],
      "properties": {
        "kind": { "enum": ["file", "project"] },
        "name": { "type": "string" },
        "revision": { "$ref": "#/$defs/digest" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_id", "name", "content_encoding", "content", "revision"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^source:[0-9]+$" },
        "name": { "type": "string" },
        "content_encoding": { "const": "utf-8" },
        "content": { "type": "string" },
        "revision": { "$ref": "#/$defs/digest" }
      }
    },
    "byteRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "source_id", "byte_range"],
      "properties": {
        "kind": { "const": "source" },
        "source_id": { "type": "string", "pattern": "^source:[0-9]+$" },
        "byte_range": { "$ref": "#/$defs/byteRange" }
      }
    },
    "subjectLocation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": { "kind": { "const": "subject" } }
    },
    "findingLocation": {
      "oneOf": [
        { "$ref": "#/$defs/sourceLocation" },
        { "$ref": "#/$defs/subjectLocation" }
      ]
    },
    "compatibilityContainerDetails": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "container_kind", "name"],
      "properties": {
        "kind": { "const": "compatibility_container" },
        "container_kind": { "enum": ["module", "service", "event", "flow", "lifecycle", "policy"] },
        "name": { "type": "string" }
      }
    },
    "actionSoftBehaviorDetails": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "action", "behavior"],
      "properties": {
        "kind": { "const": "action_soft_behavior" },
        "action": { "type": "string" },
        "behavior": { "enum": ["atomic", "idempotent", "timeout", "retry", "implementation_hint"] }
      }
    },
    "coverageDetails": {
      "oneOf": [
        { "$ref": "#/$defs/compatibilityContainerDetails" },
        { "$ref": "#/$defs/actionSoftBehaviorDetails" }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["finding_id", "severity", "category", "code", "message", "primary_location"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^finding:[0-9]+$" },
        "severity": { "enum": ["error", "warning"] },
        "category": { "enum": ["lexical", "syntax", "project", "semantic", "coverage"] },
        "code": { "type": "string", "pattern": "^MORVA[0-9]{4}$" },
        "message": { "type": "string" },
        "primary_location": { "$ref": "#/$defs/findingLocation" },
        "details": { "$ref": "#/$defs/coverageDetails" }
      }
    },
    "unmodeled": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/compatibilityContainerDetails" },
            {
              "type": "object",
              "required": ["location"],
              "properties": { "location": { "$ref": "#/$defs/sourceLocation" } }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionSoftBehaviorDetails" },
            {
              "type": "object",
              "required": ["location"],
              "properties": { "location": { "$ref": "#/$defs/sourceLocation" } }
            }
          ]
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["assessment", "fully_modeled", "unmodeled"],
      "properties": {
        "assessment": { "enum": ["complete", "unavailable"] },
        "fully_modeled": { "type": ["boolean", "null"] },
        "unmodeled": { "type": "array", "items": { "$ref": "#/$defs/unmodeled" } }
      },
      "allOf": [
        {
          "if": { "properties": { "assessment": { "const": "unavailable" } }, "required": ["assessment"] },
          "then": { "properties": { "fully_modeled": { "type": "null" }, "unmodeled": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "assessment": { "const": "complete" } }, "required": ["assessment"] },
          "then": { "properties": { "fully_modeled": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "fully_modeled": { "const": true } }, "required": ["fully_modeled"] },
          "then": { "properties": { "unmodeled": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "fully_modeled": { "const": false } }, "required": ["fully_modeled"] },
          "then": { "properties": { "unmodeled": { "minItems": 1 } } }
        }
      ]
    },
    "builtinType": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "builtin" },
        "name": { "enum": ["Boolean", "Integer", "Decimal", "String", "Id"] }
      }
    },
    "semanticType": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "semantic_key"],
      "properties": {
        "kind": { "enum": ["entity", "enum"] },
        "semantic_key": { "type": "string", "minLength": 1 }
      }
    },
    "typeRef": {
      "oneOf": [
        { "$ref": "#/$defs/builtinType" },
        { "$ref": "#/$defs/semanticType" }
      ]
    },
    "containerRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["container_kind", "name", "location"],
      "properties": {
        "container_kind": { "enum": ["module", "service", "event", "flow", "lifecycle", "policy"] },
        "name": { "type": "string" },
        "location": { "$ref": "#/$defs/sourceLocation" }
      }
    },
    "namedNodeBase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "node_id", "semantic_key", "name", "location"],
      "properties": {
        "kind": { "type": "string" },
        "node_id": { "type": "string", "pattern": "^node:.+" },
        "semantic_key": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "location": { "$ref": "#/$defs/sourceLocation" }
      }
    },
    "field": {
      "allOf": [
        { "$ref": "#/$defs/namedNodeBase" },
        {
          "type": "object",
          "required": ["kind", "type"],
          "properties": {
            "kind": { "const": "field" },
            "type": { "$ref": "#/$defs/typeRef" }
          }
        }
      ]
    },
    "enumMember": {
      "allOf": [
        { "$ref": "#/$defs/namedNodeBase" },
        {
          "type": "object",
          "required": ["kind", "enum_semantic_key"],
          "properties": {
            "kind": { "const": "enum_member" },
            "enum_semantic_key": { "type": "string" }
          }
        }
      ]
    },
    "parameter": {
      "allOf": [
        { "$ref": "#/$defs/namedNodeBase" },
        {
          "type": "object",
          "required": ["kind", "action_semantic_key", "type"],
          "properties": {
            "kind": { "const": "parameter" },
            "action_semantic_key": { "type": "string" },
            "type": { "$ref": "#/$defs/typeRef" }
          }
        }
      ]
    },
    "pathSegment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "resolved_type", "location"],
      "properties": {
        "name": { "type": "string" },
        "resolved_type": { "$ref": "#/$defs/typeRef" },
        "location": { "$ref": "#/$defs/sourceLocation" }
      }
    },
    "pathRoot": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind", "semantic_key"],
          "properties": {
            "kind": { "enum": ["action_parameter", "entity_self"] },
            "semantic_key": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind", "name", "type"],
          "properties": {
            "kind": { "const": "scenario_instance" },
            "name": { "type": "string" },
            "type": { "$ref": "#/$defs/typeRef" }
          }
        }
      ]
    },
    "expressionBase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "location", "resolved_type"],
      "properties": {
        "kind": { "type": "string" },
        "location": { "$ref": "#/$defs/sourceLocation" },
        "resolved_type": { "$ref": "#/$defs/typeRef" }
      }
    },
    "integerExpression": {
      "allOf": [
        { "$ref": "#/$defs/expressionBase" },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "integer" },
            "value": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" },
            "resolved_type": {
              "oneOf": [
                { "type": "object", "required": ["kind", "name"], "properties": { "kind": { "const": "builtin" }, "name": { "const": "Integer" } } },
                { "type": "object", "required": ["kind", "name"], "properties": { "kind": { "const": "builtin" }, "name": { "const": "Decimal" } } }
              ]
            }
          }
        }
      ]
    },
    "booleanExpression": {
      "allOf": [
        { "$ref": "#/$defs/expressionBase" },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "boolean" },
            "value": { "type": "boolean" },
            "resolved_type": { "type": "object", "required": ["kind", "name"], "properties": { "kind": { "const": "builtin" }, "name": { "const": "Boolean" } } }
          }
        }
      ]
    },
    "enumMemberExpression": {
      "allOf": [
        { "$ref": "#/$defs/expressionBase" },
        {
          "type": "object",
          "required": ["kind", "enum_semantic_key", "member_semantic_key", "member"],
          "properties": {
            "kind": { "const": "enum_member" },
            "enum_semantic_key": { "type": "string" },
            "member_semantic_key": { "type": "string" },
            "member": { "type": "string" },
            "resolved_type": { "type": "object", "required": ["kind", "semantic_key"], "properties": { "kind": { "const": "enum" }, "semantic_key": { "type": "string", "minLength": 1 } } }
          }
        }
      ]
    },
    "pathExpression": {
      "allOf": [
        { "$ref": "#/$defs/expressionBase" },
        {
          "type": "object",
          "required": ["kind", "root", "segments"],
          "properties": {
            "kind": { "const": "path" },
            "root": { "$ref": "#/$defs/pathRoot" },
            "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pathSegment" } }
          }
        }
      ]
    },
    "binaryExpression": {
      "allOf": [
        { "$ref": "#/$defs/expressionBase" },
        {
          "type": "object",
          "required": ["kind", "operator", "left", "right"],
          "properties": {
            "kind": { "const": "binary" },
            "operator": { "enum": ["equal", "not_equal", "greater", "greater_equal", "less", "less_equal"] },
            "left": { "$ref": "#/$defs/expression" },
            "right": { "$ref": "#/$defs/expression" },
            "resolved_type": { "type": "object", "required": ["kind", "name"], "properties": { "kind": { "const": "builtin" }, "name": { "const": "Boolean" } } }
          }
        }
      ]
    },
    "notExpression": {
      "allOf": [
        { "$ref": "#/$defs/expressionBase" },
        {
          "type": "object",
          "required": ["kind", "operand"],
          "properties": {
            "kind": { "const": "not" },
            "operand": { "$ref": "#/$defs/expression" },
            "resolved_type": { "type": "object", "required": ["kind", "name"], "properties": { "kind": { "const": "builtin" }, "name": { "const": "Boolean" } } }
          }
        }
      ]
    },
    "orExpression": {
      "allOf": [
        { "$ref": "#/$defs/expressionBase" },
        {
          "type": "object",
          "required": ["kind", "left", "right"],
          "properties": {
            "kind": { "const": "or" },
            "left": { "$ref": "#/$defs/expression" },
            "right": { "$ref": "#/$defs/expression" },
            "resolved_type": { "type": "object", "required": ["kind", "name"], "properties": { "kind": { "const": "builtin" }, "name": { "const": "Boolean" } } }
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        { "$ref": "#/$defs/integerExpression" },
        { "$ref": "#/$defs/booleanExpression" },
        { "$ref": "#/$defs/enumMemberExpression" },
        { "$ref": "#/$defs/pathExpression" },
        { "$ref": "#/$defs/binaryExpression" },
        { "$ref": "#/$defs/notExpression" },
        { "$ref": "#/$defs/orExpression" }
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["target", "operator", "value", "target_type", "location"],
      "properties": {
        "target": { "$ref": "#/$defs/pathExpression" },
        "operator": { "enum": ["set", "add", "subtract"] },
        "value": { "$ref": "#/$defs/expression" },
        "target_type": { "$ref": "#/$defs/typeRef" },
        "location": { "$ref": "#/$defs/sourceLocation" }
      }
    },
    "predicateClauseExpression": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "expression"],
      "properties": { "kind": { "const": "predicate" }, "expression": { "$ref": "#/$defs/expression" } }
    },
    "assignmentClauseExpression": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "assignment"],
      "properties": { "kind": { "const": "assignment" }, "assignment": { "$ref": "#/$defs/assignment" } }
    },
    "clause": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "clause_kind", "state_phase", "expressions", "location"],
      "properties": {
        "kind": { "const": "clause" },
        "clause_kind": { "enum": ["requires", "effects", "ensures", "invariant"] },
        "state_phase": { "enum": ["pre", "effect", "post", "both"] },
        "expressions": { "type": "array", "minItems": 1 },
        "location": { "$ref": "#/$defs/sourceLocation" }
      },
      "oneOf": [
        { "properties": { "clause_kind": { "const": "requires" }, "state_phase": { "const": "pre" }, "expressions": { "items": { "$ref": "#/$defs/predicateClauseExpression" } } } },
        { "properties": { "clause_kind": { "const": "effects" }, "state_phase": { "const": "effect" }, "expressions": { "items": { "$ref": "#/$defs/assignmentClauseExpression" } } } },
        { "properties": { "clause_kind": { "const": "ensures" }, "state_phase": { "const": "post" }, "expressions": { "items": { "$ref": "#/$defs/predicateClauseExpression" } } } },
        { "properties": { "clause_kind": { "const": "invariant" }, "state_phase": { "const": "both" }, "expressions": { "items": { "$ref": "#/$defs/predicateClauseExpression" } } } }
      ]
    },
    "runArgument": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "parameter_semantic_key", "type", "location"],
      "properties": {
        "name": { "type": "string" },
        "parameter_semantic_key": { "type": "string" },
        "type": { "type": "object", "required": ["kind", "semantic_key"], "properties": { "kind": { "const": "entity" }, "semantic_key": { "type": "string", "minLength": 1 } } },
        "location": { "$ref": "#/$defs/sourceLocation" }
      }
    },
    "scenarioItem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind", "assignment", "location"],
          "properties": {
            "kind": { "const": "given" },
            "assignment": { "$ref": "#/$defs/assignment" },
            "location": { "$ref": "#/$defs/sourceLocation" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind", "action_semantic_key", "arguments", "location"],
          "properties": {
            "kind": { "const": "run" },
            "action_semantic_key": { "type": "string" },
            "arguments": { "type": "array", "items": { "$ref": "#/$defs/runArgument" } },
            "location": { "$ref": "#/$defs/sourceLocation" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind", "expression", "location"],
          "properties": {
            "kind": { "const": "expect" },
            "expression": { "$ref": "#/$defs/expression" },
            "location": { "$ref": "#/$defs/sourceLocation" }
          }
        }
      ]
    },
    "declarationBase": {
      "allOf": [
        { "$ref": "#/$defs/namedNodeBase" },
        {
          "type": "object",
          "required": ["container_path"],
          "properties": {
            "container_path": { "type": "array", "items": { "$ref": "#/$defs/containerRef" } }
          }
        }
      ]
    },
    "enumDeclaration": {
      "allOf": [
        { "$ref": "#/$defs/declarationBase" },
        {
          "type": "object",
          "required": ["kind", "members"],
          "properties": {
            "kind": { "const": "enum" },
            "members": { "type": "array", "items": { "$ref": "#/$defs/enumMember" } }
          }
        }
      ]
    },
    "entityDeclaration": {
      "allOf": [
        { "$ref": "#/$defs/declarationBase" },
        {
          "type": "object",
          "required": ["kind", "fields", "invariants"],
          "properties": {
            "kind": { "const": "entity" },
            "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
            "invariants": { "type": "array", "items": { "$ref": "#/$defs/expression" } }
          }
        }
      ]
    },
    "actionDeclaration": {
      "allOf": [
        { "$ref": "#/$defs/declarationBase" },
        {
          "type": "object",
          "required": ["kind", "parameters", "clauses"],
          "properties": {
            "kind": { "const": "action" },
            "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
            "clauses": { "type": "array", "items": { "$ref": "#/$defs/clause" } }
          }
        }
      ]
    },
    "scenarioDeclaration": {
      "allOf": [
        { "$ref": "#/$defs/declarationBase" },
        {
          "type": "object",
          "required": ["kind", "items"],
          "properties": {
            "kind": { "const": "scenario" },
            "items": { "type": "array", "items": { "$ref": "#/$defs/scenarioItem" } }
          }
        }
      ]
    },
    "declaration": {
      "oneOf": [
        { "$ref": "#/$defs/enumDeclaration" },
        { "$ref": "#/$defs/entityDeclaration" },
        { "$ref": "#/$defs/actionDeclaration" },
        { "$ref": "#/$defs/scenarioDeclaration" }
      ]
    },
    "system": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "node_id", "semantic_key", "name", "shell_locations", "declarations"],
      "properties": {
        "kind": { "const": "system" },
        "node_id": { "type": "string", "pattern": "^node:.+" },
        "semantic_key": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "shell_locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceLocation" } },
        "declarations": { "type": "array", "items": { "$ref": "#/$defs/declaration" } }
      }
    },
    "checkedModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["language", "language_version", "system"],
      "properties": {
        "language": { "const": "morva" },
        "language_version": { "const": "0.1" },
        "system": { "$ref": "#/$defs/system" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "findings", "coverage", "checked_model"],
      "properties": {
        "status": { "enum": ["valid", "invalid"] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "coverage": { "$ref": "#/$defs/coverage" },
        "checked_model": { "oneOf": [{ "$ref": "#/$defs/checkedModel" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "invalid" } }, "required": ["status"] },
          "then": {
            "properties": {
              "checked_model": { "type": "null" },
              "findings": {
                "contains": {
                  "type": "object",
                  "properties": { "severity": { "const": "error" } },
                  "required": ["severity"]
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "valid" } }, "required": ["status"] },
          "then": {
            "properties": {
              "checked_model": { "$ref": "#/$defs/checkedModel" },
              "coverage": { "properties": { "assessment": { "const": "complete" } } },
              "findings": {
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": { "severity": { "const": "error" } },
                    "required": ["severity"]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
