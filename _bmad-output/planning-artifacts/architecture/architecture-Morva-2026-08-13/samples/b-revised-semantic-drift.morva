system RiskReview {
  enum ReviewStatus {
    Pending
    Failed
    Submitted
  }

  entity ReviewRequest {
    id: ID
    status: ReviewStatus
    suspended: Boolean
  }

  action Resubmit(request: ReviewRequest) {
    requires request.status == Pending
    requires request.suspended == false
    effects request.status = Submitted
    ensures request.status == Submitted
  }
}
